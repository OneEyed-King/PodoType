# Copy this file to .env (same folder as docker-compose.yml) and edit as
# needed, then run `docker compose up -d`. Every value below is optional —
# PodoType works with none of these set, using the defaults shown.

# Port the dashboard/API is published on (http://localhost:<this>).
PODOTYPE_UI_PORT=8973

# Port OTLP/HTTP traces land on — this is what Beyla (inside the app
# container) sends to, and also what the optional "Code Tracing" feature's
# generated compose override points at if you apply it to another stack.
PODOTYPE_OTLP_PORT=4318

# ClickHouse's own HTTP port, published to the host in case you want to
# point your own Grafana or another tool at it directly.
PODOTYPE_CLICKHOUSE_PORT=8123

# Leave blank (default) for local/trusted-network use. Set this to a real
# secret only if PodoType's dashboard/API port will be reachable from
# outside a network you trust — see docker-compose.yml's own comment on
# ENGINE_API_KEY for why it's unauthenticated by default.
PODOTYPE_ENGINE_API_KEY=
